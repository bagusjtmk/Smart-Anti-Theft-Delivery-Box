# Ganti PROJECT_ID dengan nama unik kelompokmu (huruf, angka, - dan _)
PROJECT_ID=kelas_iot_kelompok_XX

# Broker publik HiveMQ: tanpa daftar akun
MQTT_HOST=broker.hivemq.com
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=
# Dipakai dashboard (browser) lewat WebSocket TLS
MQTT_WS_URL=wss://broker.hivemq.com:8884/mqtt

# Nama perangkat (bagian dari topic)
BOX_DEVICE_ID=box1
OWNER_DEVICE_ID=owner1

# Sampling: 1 window = WINDOW_SIZE sampel, 1 telemetry per window
WINDOW_SIZE=5
SAMPLE_INTERVAL=0.2

# Ambang deteksi guncangan (m/s^2, RMS) - HP diam biasanya < 0.1
TAMPER_RMS=0.7

# Sensor tutup kotak: light | proximity | either | both
#  light     : tutup dianggap TERBUKA jika lux naik (kotak gelap saat tertutup)
#  proximity : tutup dianggap TERBUKA jika jarak >= PROXIMITY_FAR_CM
#  either    : terbuka jika salah satu sensor bilang terbuka
#  both      : terbuka jika kedua sensor bilang terbuka
LID_SENSOR=light
LIGHT_OPEN_LUX=15
LIGHT_CLOSE_LUX=8
PROXIMITY_FAR_CM=3

# Detector (laptop)
ARM_ON_START=true
ARM_GRACE_S=5
ALERT_HOLD_S=10
ALERT_REPEAT_S=10
STALE_S=15
DASHBOARD_PORT=8000
# Opsional: jika diisi, perintah ARM/DISARM/ACK harus membawa token yang sama
CONTROL_TOKEN=
